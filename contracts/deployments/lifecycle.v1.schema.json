{
  "$defs": {
    "BuildEvidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "build_id": {
          "format": "uuid",
          "title": "Build Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "template": {
          "enum": [
            "python-api",
            "react-spa",
            "fullstack-fastapi-react"
          ],
          "title": "Template",
          "type": "string"
        },
        "checks": {
          "items": {
            "enum": [
              "api-passed",
              "web-passed"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "manifest_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "config_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "archive_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Archive Sha256",
          "type": "string"
        },
        "archive_size": {
          "exclusiveMinimum": 0,
          "maximum": 2147483648,
          "title": "Archive Size",
          "type": "integer"
        },
        "check_recipe_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Check Recipe Sha256",
          "type": "string"
        },
        "check_requirements_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Check Requirements Sha256",
          "type": "string"
        },
        "image_recipe_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Image Recipe Sha256",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        }
      },
      "required": [
        "build_id",
        "workspace_id",
        "source_hash",
        "plan_hash",
        "template",
        "checks",
        "manifest_digest",
        "config_digest",
        "archive_sha256",
        "archive_size",
        "check_recipe_sha256",
        "check_requirements_sha256",
        "image_recipe_sha256",
        "finished_at"
      ],
      "title": "BuildEvidence",
      "type": "object"
    },
    "DeploymentPlan": {
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "pattern": "^[a-z][a-z0-9-]{1,62}$",
          "title": "Definition Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        },
        "image": {
          "pattern": "^(sha256:[a-f0-9]{64}|[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64})$",
          "title": "Image",
          "type": "string"
        },
        "internal_port": {
          "maximum": 65535,
          "minimum": 1024,
          "title": "Internal Port",
          "type": "integer"
        },
        "data_path": {
          "anyOf": [
            {
              "pattern": "^/(data|app/data|var/lib/[a-z][a-z0-9-]*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Path"
        },
        "user": {
          "default": "10001:10001",
          "enum": [
            "10001:10001",
            "101"
          ],
          "title": "User",
          "type": "string"
        },
        "memory_mb": {
          "default": 128,
          "maximum": 1024,
          "minimum": 32,
          "title": "Memory Mb",
          "type": "integer"
        },
        "cpus": {
          "default": 0.5,
          "maximum": 2,
          "minimum": 0.1,
          "title": "Cpus",
          "type": "number"
        },
        "profile": {
          "default": "web-v1",
          "enum": [
            "web-v1",
            "notes-postgres-v1",
            "forge-spa-v1"
          ],
          "title": "Profile",
          "type": "string"
        },
        "database_image": {
          "anyOf": [
            {
              "pattern": "^(sha256:[a-f0-9]{64}|[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Database Image"
        },
        "source_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Hash"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "provider": {
          "const": "docker-compose",
          "default": "docker-compose",
          "title": "Provider",
          "type": "string"
        },
        "installation_id": {
          "format": "uuid",
          "title": "Installation Id",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstallationContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "forge": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForgeReleaseProof"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "definition_id",
        "version",
        "image",
        "internal_port",
        "installation_id"
      ],
      "title": "DeploymentPlan",
      "type": "object"
    },
    "ForgeReleaseProof": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "$ref": "#/$defs/SignedBuildEvidence"
        },
        "preview": {
          "$ref": "#/$defs/SignedPreviewEvidence"
        }
      },
      "required": [
        "build",
        "preview"
      ],
      "title": "ForgeReleaseProof",
      "type": "object"
    },
    "InstallationContext": {
      "additionalProperties": false,
      "properties": {
        "household_id": {
          "format": "uuid",
          "title": "Household Id",
          "type": "string"
        },
        "subject": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "manifest_id": {
          "format": "uuid",
          "title": "Manifest Id",
          "type": "string"
        },
        "manifest_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Manifest Hash",
          "type": "string"
        }
      },
      "required": [
        "household_id",
        "subject",
        "manifest_id",
        "manifest_hash"
      ],
      "title": "InstallationContext",
      "type": "object"
    },
    "PreviewEvidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "preview_id": {
          "format": "uuid",
          "title": "Preview Id",
          "type": "string"
        },
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "artifact_evidence_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Artifact Evidence Hash",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "plan_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "manifest_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "config_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "container_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Container Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "state": {
          "const": "healthy",
          "default": "healthy",
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "preview_id",
        "artifact_id",
        "workspace_id",
        "artifact_evidence_hash",
        "source_hash",
        "plan_hash",
        "manifest_digest",
        "config_digest",
        "container_id",
        "observed_at",
        "expires_at"
      ],
      "title": "PreviewEvidence",
      "type": "object"
    },
    "SignedBuildEvidence": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "default": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Key Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/BuildEvidence"
        },
        "signature": {
          "maxLength": 88,
          "minLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "evidence",
        "signature"
      ],
      "title": "SignedBuildEvidence",
      "type": "object"
    },
    "SignedPreviewEvidence": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "default": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Key Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/PreviewEvidence"
        },
        "signature": {
          "maxLength": 88,
          "minLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "evidence",
        "signature"
      ],
      "title": "SignedPreviewEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "action": {
      "enum": [
        "start",
        "stop",
        "restart"
      ],
      "title": "Action",
      "type": "string"
    },
    "resource_type": {
      "const": "app_installation",
      "default": "app_installation",
      "title": "Resource Type",
      "type": "string"
    },
    "resource_id": {
      "format": "uuid",
      "title": "Resource Id",
      "type": "string"
    },
    "subject": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/DeploymentPlan"
    }
  },
  "required": [
    "action",
    "resource_id",
    "subject",
    "runtime"
  ],
  "title": "LifecyclePlan",
  "type": "object"
}
