{
  "openapi": "3.1.0",
  "info": {
    "title": "DKMan Deployment Adapter",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "getAdapterLiveness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Getadapterliveness"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "getAdapterReadiness",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Getadapterreadiness"
                }
              }
            }
          }
        }
      }
    },
    "/v1/plans": {
      "post": {
        "summary": "Plan",
        "operationId": "planDeployment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeploymentPlan"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/operations/{operation_id}": {
      "post": {
        "summary": "Execute",
        "operationId": "executeDeploymentOperation",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Operation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeploymentCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Operation",
        "operationId": "getDeploymentOperation",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Operation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/operations/{operation_id}/reconcile": {
      "get": {
        "summary": "Reconcile",
        "operationId": "observeUncertainDeploymentOperation",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Operation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Reconcile Evidence",
        "operationId": "reconcileDeploymentEvidence",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "operation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Operation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompletionEvidence": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "engine_acknowledgement",
            "title": "Kind",
            "default": "engine_acknowledgement"
          },
          "receipt": {
            "$ref": "#/components/schemas/EngineReceipt"
          },
          "after": {
            "$ref": "#/components/schemas/WorkloadEvidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "receipt",
          "after"
        ],
        "title": "CompletionEvidence"
      },
      "ContainerEvidence": {
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "app",
              "database"
            ],
            "title": "Service"
          },
          "container_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Container Id"
          },
          "image_id": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$",
            "title": "Image Id"
          },
          "runtime_plan_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Runtime Plan Hash"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "running",
              "paused",
              "restarting",
              "removing",
              "exited",
              "dead"
            ],
            "title": "Status"
          },
          "health": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "healthy",
                  "starting",
                  "unhealthy"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Health"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "title": "Finished At"
          },
          "volumes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 1,
            "title": "Volumes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "service",
          "container_id",
          "image_id",
          "runtime_plan_hash",
          "status",
          "started_at",
          "finished_at",
          "volumes"
        ],
        "title": "ContainerEvidence"
      },
      "DeploymentCommand": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "discover",
              "pull",
              "install",
              "deploy",
              "start",
              "stop",
              "restart",
              "status",
              "logs",
              "remove",
              "remove_data"
            ],
            "title": "Action"
          },
          "plan": {
            "$ref": "#/components/schemas/DeploymentPlan"
          },
          "lifecycle": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LifecyclePlan"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "plan"
        ],
        "title": "DeploymentCommand"
      },
      "DeploymentPlan": {
        "properties": {
          "definition_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$",
            "title": "Definition Id"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "title": "Version"
          },
          "image": {
            "type": "string",
            "pattern": "^(sha256:[a-f0-9]{64}|[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64})$",
            "title": "Image"
          },
          "internal_port": {
            "type": "integer",
            "maximum": 65535.0,
            "minimum": 1024.0,
            "title": "Internal Port"
          },
          "data_path": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^/(data|app/data|var/lib/[a-z][a-z0-9-]*)$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Path"
          },
          "user": {
            "type": "string",
            "const": "10001:10001",
            "title": "User",
            "default": "10001:10001"
          },
          "memory_mb": {
            "type": "integer",
            "maximum": 1024.0,
            "minimum": 32.0,
            "title": "Memory Mb",
            "default": 128
          },
          "cpus": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.1,
            "title": "Cpus",
            "default": 0.5
          },
          "profile": {
            "type": "string",
            "enum": [
              "web-v1",
              "notes-postgres-v1"
            ],
            "title": "Profile",
            "default": "web-v1"
          },
          "database_image": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(sha256:[a-f0-9]{64}|[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64})$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database Image"
          },
          "source_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Hash"
          },
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "provider": {
            "type": "string",
            "const": "docker-compose",
            "title": "Provider",
            "default": "docker-compose"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Installation Id"
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InstallationContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "definition_id",
          "version",
          "image",
          "internal_port",
          "installation_id"
        ],
        "title": "DeploymentPlan"
      },
      "EngineReceipt": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Installation Id"
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "start",
                  "stop",
                  "restart"
                ]
              },
              {
                "type": "string",
                "const": "install"
              }
            ],
            "title": "Action"
          },
          "plan_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Plan Hash"
          },
          "before": {
            "$ref": "#/components/schemas/WorkloadEvidence"
          },
          "acknowledged_at": {
            "type": "string",
            "format": "date-time",
            "title": "Acknowledged At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
          "installation_id",
          "action",
          "plan_hash",
          "before",
          "acknowledged_at"
        ],
        "title": "EngineReceipt"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InstallationContext": {
        "properties": {
          "household_id": {
            "type": "string",
            "format": "uuid",
            "title": "Household Id"
          },
          "subject": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Subject"
          },
          "manifest_id": {
            "type": "string",
            "format": "uuid",
            "title": "Manifest Id"
          },
          "manifest_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Manifest Hash"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "household_id",
          "subject",
          "manifest_id",
          "manifest_hash"
        ],
        "title": "InstallationContext"
      },
      "LifecyclePlan": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "start",
              "stop",
              "restart"
            ],
            "title": "Action"
          },
          "resource_type": {
            "type": "string",
            "const": "app_installation",
            "title": "Resource Type",
            "default": "app_installation"
          },
          "resource_id": {
            "type": "string",
            "format": "uuid",
            "title": "Resource Id"
          },
          "subject": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Subject"
          },
          "runtime": {
            "$ref": "#/components/schemas/DeploymentPlan"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "resource_id",
          "subject",
          "runtime"
        ],
        "title": "LifecyclePlan"
      },
      "OperationView": {
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Installation Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "discover",
              "pull",
              "install",
              "deploy",
              "start",
              "stop",
              "restart",
              "status",
              "logs",
              "remove",
              "remove_data"
            ],
            "title": "Action"
          },
          "plan_hash": {
            "type": "string",
            "title": "Plan Hash"
          },
          "state": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed",
              "reconciliation_required"
            ],
            "title": "State"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "failure_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Code"
          },
          "runtime": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RuntimeView"
              },
              {
                "type": "null"
              }
            ]
          },
          "logs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Logs"
          },
          "completion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompletionEvidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "rejection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RejectionEvidence"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
          "installation_id",
          "action",
          "plan_hash",
          "state",
          "created_at"
        ],
        "title": "OperationView"
      },
      "PlanRequest": {
        "properties": {
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Installation Id"
          },
          "definition_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,62}$",
            "title": "Definition Id"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "title": "Version"
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InstallationContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "installation_id",
          "definition_id",
          "version"
        ],
        "title": "PlanRequest"
      },
      "RejectionEvidence": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "preflight_rejected",
            "title": "Kind",
            "default": "preflight_rejected"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Operation Id"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Installation Id"
          },
          "action": {
            "type": "string",
            "enum": [
              "discover",
              "pull",
              "install",
              "deploy",
              "start",
              "stop",
              "restart",
              "status",
              "logs",
              "remove",
              "remove_data"
            ],
            "title": "Action"
          },
          "plan_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Plan Hash"
          },
          "reason": {
            "type": "string",
            "enum": [
              "curation_rejected",
              "resource_preflight_rejected",
              "engine_preflight_unavailable"
            ],
            "title": "Reason"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
          "installation_id",
          "action",
          "plan_hash",
          "reason",
          "observed_at"
        ],
        "title": "RejectionEvidence"
      },
      "RuntimeView": {
        "properties": {
          "installation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Installation Id"
          },
          "state": {
            "type": "string",
            "enum": [
              "absent",
              "running",
              "stopped",
              "starting",
              "unhealthy",
              "unknown"
            ],
            "title": "State"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "container_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Container Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "installation_id",
          "state",
          "observed_at"
        ],
        "title": "RuntimeView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkloadEvidence": {
        "properties": {
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "containers": {
            "items": {
              "$ref": "#/components/schemas/ContainerEvidence"
            },
            "type": "array",
            "maxItems": 2,
            "title": "Containers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observed_at",
          "containers"
        ],
        "title": "WorkloadEvidence"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
