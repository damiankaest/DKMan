{
  "name": "@dkman/service-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:journey": "playwright test --config=playwright.journey.config.ts",
    "generate:api": "openapi-typescript ../../contracts/openapi/core.v1.json -o src/generated/api.ts"
  },
  "dependencies": {
    "react": "19.3.1", "react-dom": "19.3.1", "keycloak-js": "26.2.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@types/node": "26.6.5",
    "vite": "8.3.4", "@vitejs/plugin-react": "6.1.2", "typescript": "5.9.3",
    "vitest": "5.0.5", "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1", "jsdom": "30.1.3",
    "eslint": "10.13.0", "@eslint/js": "10.0.1", "typescript-eslint": "8.72.0",
    "@playwright/test": "1.64.1", "openapi-typescript": "7.13.0"
  }
}
